    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "google-play-scraper": "^10.1.3",
    "hono": "^4.13.5",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.27.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.407.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "react-router": "^7.18.3",
