    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^6.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
