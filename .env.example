DATABASE_URL="postgresql://aso:aso@localhost:5433/aso"
CRON_SECRET="change-me-to-a-random-string"

# Optional: usage analytics for this instance. Leave unset to disable — this
# is a self-hosted single-user tool, analytics are opt-in.
# VITE_POSTHOG_KEY="phc_..."
# VITE_POSTHOG_HOST="https://us.i.posthog.com"

# Optional: powers the "AI Copy Suggestions" panel via OpenRouter (works with
# any model on openrouter.ai/models). Leave unset to disable the feature.
# OPENROUTER_API_KEY="sk-or-..."
# OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# Optional: gates POST/DELETE to /api/mcp with a bearer token. Leave unset to
# keep it open (fine for localhost-only use) - set this before exposing it
# beyond localhost, since it otherwise has full read/write access to your
# ASO data.
# MCP_AUTH_TOKEN="..."
